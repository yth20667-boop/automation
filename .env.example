# =============================================================================
# VALON — Hair Care · Variables d'environnement
# Copiez ce fichier en `.env.local` puis remplissez les valeurs.
# `.env.local` n'est JAMAIS commité (voir .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Facebook / Meta Pixel (CÔTÉ CLIENT — exposé au navigateur)
# Tableau de bord Events Manager → votre Pixel → ID du pixel.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FB_PIXEL_ID=000000000000000

# -----------------------------------------------------------------------------
# Conversions API / CAPI (CÔTÉ SERVEUR — SECRET, ne jamais exposer)
# Events Manager → Paramètres → API de conversions → Générer un token d'accès.
# -----------------------------------------------------------------------------
FB_CAPI_TOKEN=
# Optionnel : code de test pour vérifier les événements dans
# Events Manager → Test des événements. Laissez vide en production.
FB_TEST_EVENT_CODE=

# -----------------------------------------------------------------------------
# Destination des commandes (webhook configurable)
# Collez l'URL d'un scénario Make.com / Zapier / Google Apps Script / votre CRM.
# La commande complète y est POSTée en JSON. Laissez vide pour désactiver.
# -----------------------------------------------------------------------------
ORDER_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# URL publique du site (utilisée pour le SEO, le canonical, l'OG et le CAPI)
# Ex : https://valon-haircare.ma
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
